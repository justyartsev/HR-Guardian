FROM python:3.12-slim

WORKDIR /app

COPY ./requirements.txt ./

# ВАЖНО: Сначала ставим PyTorch CPU-only (гораздо легче чем с CUDA)
# Это сэкономит ~2 GB места в образе!
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Потом ставим остальные зависимости
RUN pip install --no-cache-dir --no-input -r requirements.txt

COPY ./ ./

RUN mkdir -p vectordb

# Копируем и настраиваем entrypoint
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/app/entrypoint.sh"]
