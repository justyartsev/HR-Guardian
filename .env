#Variables with # either not necessary or can be calculated

#Backend env variables
SECRET_KEY=beablodola       #secret key for encoding data
ALGORITHM=HS256             #selected algorithm for encoding data (choose between HS256, HMAC, SHA-256)     
#DATABASE_URL=


#Database env variables
POSTGRES_DB=hr
POSTGRES_USER=hr_api
POSTGRES_PASSWORD=hr_api_pass54321
DB_OPEN_PORT=5435           #var to connect to db in container. Dafault is 5435
#RAG_SERVICE_TOKEN=
#RAG_URL=

#RAG env variables
