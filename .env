# === Backend Configuration ===
SECRET_KEY=beablodola
ALGORITHM=HS256

# === Database Configuration ===
POSTGRES_DB=hr_guardian
POSTGRES_USER=hr_api
POSTGRES_PASSWORD=hr_api_pass54321
DB_OPEN_PORT=5435
DATABASE_URL=postgresql://hr_api:hr_api_pass54321@localhost:5432/hr_guardian

# === RAG Service Configuration ===
RAG_SERVICE_TOKEN=secret_rag_token_12345
RAG_CALLBACK_SECRET=secret_callback_token_67890
RAG_PORT=9000
RAG_URL=http://localhost:9000
RAG_BACKEND_URL=http://localhost:8000

# === LLM Configuration ===
LLM_BASE_URL=http://localhost:11434
# Используем qwen2.5:3b - легкая модель, проверенная и работающая (~1.9GB)
# Альтернативы: qwen2.5:1.5b (еще меньше), phi3.5:3.8b (если нужен Phi)
LLM_MODEL=qwen3:1.7b
LLM_API_KEY=ollama
LLM_WORKERS=1

# === Ollama Configuration ===
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Используем правильную переменную для Ollama (не OLLAMA_CONTEXT_LENGTH)
OLLAMA_NUM_CTX=2048

# === Application Configuration ===
APP_PORT=80
